# Next.js frontend configuration.
# All Ansible/AWX, release, Bedrock, and database configuration lives in
# backend/.env — the frontend holds no credentials and talks to the
# Express API below over plain REST (CORS-enabled).

NODE_ENV=development
PORT=3000

# Base URL of the Express backend (see backend/.env.example).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
