# Environment for the containerised stack (docker-compose.yml).
#
#   cp .env.docker.example .env.docker
#   docker compose --env-file .env.docker up -d --build
#
# The --env-file flag is required. ${...} interpolation inside
# docker-compose.yml is resolved before any container exists, and Compose reads
# it from the shell or a root `.env` — never from a service's env_file:. This
# project's root `.env` belongs to the Next.js dev server, so without the flag
# the ports, database name and SSH key mount fall back to their defaults.
#
# Copy the credentials from backend/.env — they are the same values. What is
# NOT here is deliberate: DATABASE_URL and REDIS_URL are set by compose to the
# service names, because inside a container "localhost" is that container, and
# anything set here for them would be overridden anyway.

# --- Host ports --------------------------------------------------------------
# Change these if something already occupies them on your machine.
FRONTEND_PORT=3000
BACKEND_PORT=4000
POSTGRES_PORT=5433
REDIS_PORT=6380
# Adminer, the opt-in database browser. Started only with:
#   docker compose --profile tools up -d adminer
ADMINER_PORT=8080

# The API URL as the BROWSER will use it. Inlined into the client bundle at
# build time, so changing it requires `docker compose up --build`. Use the host
# and published port a browser can reach — not "backend", which only resolves
# inside the Docker network.
PUBLIC_API_BASE_URL=http://localhost:4000

# --- Database ----------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=impact_analysis

# --- Ansible control node ----------------------------------------------------
# The EC2 instance where Ansible, the inventory, and the fleet's SSH keys live.
# Only used when ANSIBLE_PROVIDER=ec2.
ANSIBLE_PROVIDER=ec2
ANSIBLE_SSH_HOST=
ANSIBLE_SSH_USER=ec2-user
ANSIBLE_SSH_PORT=22
# Path INSIDE the container. The host path is set by ANSIBLE_SSH_KEY_HOST_PATH
# below; the entrypoint copies it somewhere private with 600 permissions,
# because ssh rejects a key readable by anyone else.
ANSIBLE_SSH_KEY_PATH=/run/secrets/ansible-key.pem
ANSIBLE_INVENTORY_PATH=/home/ec2-user/inventory
ANSIBLE_SSH_TIMEOUT_MS=30000
ANSIBLE_SSH_STRICT_HOST_KEY_CHECKING=true

# Where those two files live on the HOST. The key must exist before starting,
# or Docker creates a directory at that path and every collection fails.
ANSIBLE_SSH_KEY_HOST_PATH=./secrets/ansible-key.pem
SSH_KNOWN_HOSTS_HOST_PATH=./secrets/known_hosts

# Fetch the control node's host key on startup instead of providing one.
# Trust-on-first-use: it accepts whatever answers on that address at that
# moment, which is precisely what host-key verification exists to detect. Fine
# for a throwaway environment, wrong for a real control node — prefer filling in
# secrets/known_hosts (see secrets/README.md).
ANSIBLE_SSH_KEYSCAN=false

# --- Release lookup ----------------------------------------------------------
#   tavily | official | simulated
RELEASE_PROVIDER=tavily
TAVILY_API_KEY=
AGENT_MAX_WEB_SEARCHES=2
RELEASE_CACHE_TTL_MS=21600000
RELEASE_FAILURE_TTL_MS=300000
RELEASE_LOOKUP_CONCURRENCY=2

# --- Reasoning ---------------------------------------------------------------
#   groq | bedrock | local | mock
BEDROCK_PROVIDER=groq
GROQ_API_KEY=
# Groq retires model ids without notice, and a retired id fails every analysis
# with a 404. Confirm before setting:
#   curl -s https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
GROQ_MODEL_ID=openai/gpt-oss-120b
RELEASE_EXTRACTION_MODEL_ID=openai/gpt-oss-20b

# Amazon Bedrock (only when BEDROCK_PROVIDER=bedrock).
AWS_REGION=eu-west-1
BEDROCK_MODEL_ID=eu.amazon.nova-lite-v1:0
BEDROCK_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Embeddings --------------------------------------------------------------
# EMBEDDING_DIMENSIONS must match the vector(N) column created by the
# knowledge_chunks migration. Changing the model means a migration to alter it.
EMBEDDING_PROVIDER=pinecone
EMBEDDING_MODEL_ID=llama-text-embed-v2
EMBEDDING_DIMENSIONS=1024
PINECONE_API_KEY=
PINECONE_INDEX_HOST=

# --- Cache -------------------------------------------------------------------
# REDIS_URL itself is set by compose. These only tune behaviour.
CACHE_ENABLED=true
CACHE_TTL_SERVER_LIST=60
CACHE_TTL_SERVER_DETAILS=120
CACHE_TTL_SOFTWARE=900
