# Application
NODE_ENV=development
PORT=4000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/impact_analysis

# Ansible
#   ec2       = SSH to the Ansible control node and run read-only fact modules there
#   awx       = AWX/AAP REST API (stub — not yet connected to a live instance)
#   simulated = five fixed in-memory servers, for local development
ANSIBLE_PROVIDER=simulated

# Ansible control node (only used when ANSIBLE_PROVIDER=ec2)
# Ansible, the inventory, and the SSH keys for the managed fleet all live on
# this EC2 instance. This backend stores none of them — the inventory is owned
# by the control node and is not editable from the application.
ANSIBLE_SSH_HOST=
ANSIBLE_SSH_USER=ec2-user
ANSIBLE_SSH_PORT=22
# Path to the private key used for the backend -> control node hop.
ANSIBLE_SSH_KEY_PATH=
# Inventory path as it exists ON the control node.
ANSIBLE_INVENTORY_PATH=/etc/ansible/hosts
ANSIBLE_SSH_TIMEOUT_MS=30000
# Set to "false" only for throwaway environments — it disables SSH host-key
# verification and removes protection against a man-in-the-middle.
ANSIBLE_SSH_STRICT_HOST_KEY_CHECKING=true

# AWX (only used when ANSIBLE_PROVIDER=awx)
AWX_BASE_URL=
AWX_USERNAME=
AWX_PASSWORD=
AWX_TOKEN=
AWX_JOB_TEMPLATE_ID=

# Where "latest version" comes from:
#   tavily    = web search (Tavily) + extraction, verified against retrieved text
#   official  = GitHub Releases, but only for 4 hardcoded repos; everything else
#               returns "Insufficient data" with no network call
#   simulated = fixed local data
RELEASE_PROVIDER=simulated

# Tavily web search (required when RELEASE_PROVIDER=tavily)
# Web searches the agent may issue per analysis when evidence is insufficient.
AGENT_MAX_WEB_SEARCHES=2

TAVILY_API_KEY=

# Cache for release lookups. Without this, every page load costs one web search
# plus one extraction per package, which exhausts provider rate limits fast.
RELEASE_CACHE_TTL_MS=21600000
RELEASE_FAILURE_TTL_MS=300000
# Kept low on purpose: free LLM tiers throttle hard and the cache absorbs repeats.
RELEASE_LOOKUP_CONCURRENCY=2

# Reasoning provider for the LangGraph impact-analysis agent. The agent graph is
# identical in every case — only the three model calls differ.
#   groq    = real LLM on Groq (needs GROQ_API_KEY)
#   bedrock = real model via Amazon Bedrock (needs BEDROCK_API_KEY)
#   local   = full agent graph with deterministic reasoning, no network calls
#   mock    = legacy rule-based path that BYPASSES the agent entirely
BEDROCK_PROVIDER=local

# Groq. GROQ_MODEL_ID drives the agent's reasoning; RELEASE_EXTRACTION_MODEL_ID is
# a smaller model used only to pull version strings out of search results.
# Token-per-day quotas are PER MODEL, so keeping them separate stops release
# lookups from starving the impact analysis.
GROQ_API_KEY=
GROQ_MODEL_ID=llama-3.3-70b-versatile
RELEASE_EXTRACTION_MODEL_ID=llama-3.1-8b-instant

# AWS / Bedrock (only used when BEDROCK_PROVIDER=bedrock)
AWS_REGION=eu-west-1
BEDROCK_MODEL_ID=eu.amazon.nova-lite-v1:0
# Bedrock API key (bearer auth). Preferred over the access-key pair below.
BEDROCK_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# RAG embeddings for the pgvector knowledge base.
# EMBEDDING_DIMENSIONS must match the vector(N) column in prisma/schema.prisma.
#   pinecone = Pinecone hosted inference (llama-text-embed-v2), reusing
#              PINECONE_API_KEY. A real model; 1024 dims matches the column.
#   bedrock  = Titan/Cohere on Bedrock
#   mock     = deterministic hash vectors, NOT a real model; ranking is
#              meaningless. Only for running with no credentials at all.
EMBEDDING_PROVIDER=pinecone
EMBEDDING_MODEL_ID=llama-text-embed-v2
EMBEDDING_DIMENSIONS=1024

# Pinecone (embeddings, and the vector index if used as the store)
PINECONE_API_KEY=
PINECONE_INDEX_HOST=

# Redis response cache. Start it with "docker compose up -d" from the repo root.
# Collecting facts and looking up releases are slow remote operations, so their
# results are cached; without Redis the API still works, just slowly.
REDIS_URL=redis://127.0.0.1:6380
CACHE_ENABLED=true
CACHE_TTL_SERVER_LIST=60
CACHE_TTL_SERVER_DETAILS=120
CACHE_TTL_SOFTWARE=900
