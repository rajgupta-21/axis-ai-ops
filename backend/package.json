{
  "name": "impact-analysis-backend",
  "version": "1.0.0",
  "description": "Server Version & Patch Impact Analysis — Express API",
  "private": true,
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/src/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "check:llm": "tsx scripts/check-llm.ts",
    "check:bedrock": "tsx scripts/check-bedrock.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1108.0",
    "@langchain/aws": "^1.4.3",
    "@langchain/core": "^1.2.6",
    "@langchain/groq": "^1.3.1",
    "@langchain/langgraph": "^1.4.9",
    "@langchain/tavily": "^1.2.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "js-yaml": "^5.2.3",
    "pdfkit": "^0.19.1",
    "pg": "^8.23.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.2.0",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.21.0",
    "@types/uuid": "^10.0.0",
    "prisma": "^7.9.1",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
